# Copy to .env.local for local Vite (optional if backend/.env has GOOGLE_CLIENT_ID):
#   cp .env.example .env.local

# API base for LOCAL only. On Vercel this is ignored — /api is rewritten via vercel.json.
# VITE_API_URL=http://localhost:5000/api

# Public site URL (SEO / Open Graph / canonical) — set AFTER you buy domain + host.
# Example: VITE_SITE_URL=https://crackuex.com
# Also replace REPLACE_WITH_YOUR_DOMAIN in public/robots.txt and public/sitemap.xml
VITE_SITE_URL=

# Google Identity Services — same value as backend GOOGLE_CLIENT_ID
# Local: Vite also auto-reads backend/.env GOOGLE_CLIENT_ID (see vite.config.js)
# Vercel: leave empty; app loads it from GET /api/auth/google-config
#
# Google Cloud Console → Credentials → OAuth Web client origins:
#   http://localhost:5173
#   https://myexamprep-theta.vercel.app
VITE_GOOGLE_CLIENT_ID=
