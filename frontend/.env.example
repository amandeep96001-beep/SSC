# Copy to .env.local for Vite:
#   cp .env.example .env.local

# API base for LOCAL only. On Vercel this is ignored — /api is rewritten via vercel.json.
# Local: http://localhost:5000/api
# Do NOT set VITE_API_URL on Vercel (or it can lock the frontend to an old Render URL).
# VITE_API_URL=http://localhost:5000/api

# Google Identity Services (optional locally).
# On Vercel you can leave this empty — the app loads clientId from
# GET /api/auth/google-config (same value as backend GOOGLE_CLIENT_ID).
# Local override:
# VITE_GOOGLE_CLIENT_ID=xxxxx.apps.googleusercontent.com
#
# Google Cloud Console → Credentials → OAuth 2.0 Web client:
#   Authorized JavaScript origins:
#     http://localhost:5173
#     https://myexamprep-theta.vercel.app
VITE_GOOGLE_CLIENT_ID=
