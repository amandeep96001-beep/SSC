# Copy this file to .env and fill in your values:
#   cp .env.example .env

# MongoDB — local for dev, Atlas URI on Render (required in production)
# Local:
MONGODB_URI=mongodb://127.0.0.1:27017/ssc_prep
# Atlas (Render): Database → Connect → Drivers → copy URI, replace <password>
# MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/ssc_prep?retryWrites=true&w=majority
# If password has @ # % / : ? & → URL-encode (e.g. @ → %40). Wrong password = "bad auth".
# Atlas → Network Access: allow 0.0.0.0/0 so Render can connect.

# Required on Render/production (generate with: openssl rand -base64 48)
JWT_SECRET=change-this-to-a-long-random-string-at-least-32-chars

# Optional
PORT=5000
NODE_ENV=development

# Browser origin allowed by CORS (exact origin, no trailing slash).
# Local: http://localhost:5173
# Render: MUST be your Vercel URL, e.g. https://myexamprep-theta.vercel.app
FRONTEND_URL=http://localhost:5173
# Optional extra origins (comma-separated), e.g. preview deploys / custom domains
# FRONTEND_URLS=https://myexamprep-theta.vercel.app,https://myexamprep-git-main.vercel.app

# JWT token lifetime (default 7d)
# JWT_EXPIRES_IN=7d

# Admin: any user who signs in with this email becomes admin
# ADMIN_EMAIL=you@institute.com

# --- Email OTP (SMTP) ---
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your@gmail.com
# SMTP_PASS=your-16-char-app-password
# SMTP_FROM="ExamPrep <your@gmail.com>"
# Never set SMTP_DEBUG to return OTP in API responses — codes stay server-side only.
# SMTP_DEBUG=0

# Study reminders cron (1 = on, 0 = off). Server checks every minute; emails + in-app notifications.
# Requires SMTP + user email on the account for email delivery.
# REMINDER_CRON=1

# --- Google Sign-In (Google Identity Services) ---
# Paste the SAME Client ID on Render as GOOGLE_CLIENT_ID.
# Local: Vite also reads this from backend/.env for the login button.
# Google Cloud Console → Credentials → OAuth 2.0 Web client:
#   Authorized JavaScript origins:
#     http://localhost:5173
#     https://myexamprep-theta.vercel.app
#
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- AI Concept Explainer (Drill wrong-answer AI panel) ---
# When GEMINI_API_KEY is set, Gemini is PRIMARY (Pollinations is fallback).
# Get a free key: https://aistudio.google.com/app/apikey
# Optional model override (default: gemini-3.5-flash)
# GEMINI_API_KEY=your-gemini-api-key-here
# GEMINI_MODEL=gemini-3.5-flash
