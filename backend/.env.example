# Copy this file to .env and fill in your values:
#   cp .env.example .env

# MongoDB — local for dev, Atlas URI on Render (required in production)
# Local:
MONGODB_URI=mongodb://127.0.0.1:27017/ssc_prep
# Atlas (Render): Database → Connect → Drivers → copy URI, replace <password>
# MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/ssc_prep?retryWrites=true&w=majority
# If password has @ # % / : ? & → URL-encode (e.g. @ → %40). Wrong password = "bad auth".
# Atlas → Network Access: allow 0.0.0.0/0 so Render can connect.

# Required on Render/production (generate with: openssl rand -base64 48)
JWT_SECRET=change-this-to-a-long-random-string-at-least-32-chars

# Optional
PORT=5000
NODE_ENV=development

# Browser origin allowed by CORS (exact origin, no trailing slash).
# Local: http://localhost:5173
# Render: MUST be your Vercel URL, e.g. https://myexamprep-theta.vercel.app
FRONTEND_URL=http://localhost:5173
# Optional extra origins (comma-separated), e.g. preview deploys / custom domains
# FRONTEND_URLS=https://myexamprep-theta.vercel.app,https://myexamprep-git-main.vercel.app

# JWT token lifetime (default 24h). Outstanding tokens are also revoked on logout / password reset.
# JWT_EXPIRES_IN=24h

# Admin: only this email is promoted to admin on register / Google / verify.
# Do not use username or shared admin codes — those are privilege-escalation risks.
# ADMIN_EMAIL=you@institute.com

# Optional Mongo auth DB (default: admin, typical for Atlas). Override if your URI sets authSource.
# MONGODB_AUTH_SOURCE=admin

# --- Email OTP (SMTP) ---
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your@gmail.com
# SMTP_PASS=your-16-char-app-password
# SMTP_FROM="CrackuEx <your@gmail.com>"
# Never set SMTP_DEBUG to return OTP in API responses — codes stay server-side only.
# SMTP_DEBUG=0

# Study reminders cron (1 = on, 0 = off). Server checks every minute; emails + in-app notifications.
# Requires SMTP + user email on the account for email delivery.
# REMINDER_CRON=1

# --- Google Sign-In (Google Identity Services) ---
# Paste the SAME Client ID on Render as GOOGLE_CLIENT_ID.
# Local: Vite also reads this from backend/.env for the login button.
# Google Cloud Console → Credentials → OAuth 2.0 Web client:
#   Authorized JavaScript origins:
#     http://localhost:5173
#     https://myexamprep-theta.vercel.app
#
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- AI Concept Explainer (Drill wrong-answer AI panel) ---
# When GEMINI_API_KEY is set, Gemini is PRIMARY (Pollinations is fallback).
# Get a free key: https://aistudio.google.com/app/apikey
# Optional model override (default: gemini-3.5-flash)
# GEMINI_API_KEY=your-gemini-api-key-here
# GEMINI_MODEL=gemini-3.5-flash

# --- Scale (50L+ readiness) ---
# Redis (strongly recommended for multi-instance rate limits + shared auth/AI cache).
# Local: redis://127.0.0.1:6379
# Upstash / Redis Cloud / Render Redis: paste rediss://... URL
# REDIS_URL=

# Mongo connection pool (defaults: max 50, min 5)
# MONGODB_MAX_POOL=50
# MONGODB_MIN_POOL=5

# Auth session cache TTL seconds (cuts DB hit on every authenticated request)
# AUTH_CACHE_TTL_SEC=45

# Cap progress rows returned on login /auth/me (newest first)
# SESSION_PROGRESS_LIMIT=1500
# SESSION_MOCK_PROGRESS_LIMIT=500

# Rate limits (per IP, 15-minute windows; shared across instances when REDIS_URL set)
# RATE_LIMIT_API_MAX=1200
# RATE_LIMIT_AUTH_MAX=20
# RATE_LIMIT_OTP_MAX=10
# RATE_LIMIT_AI_MAX=30

# AI explanation cache (seconds). Same wrong-question hits reuse cached answer.
# AI_EXPLAIN_CACHE_TTL_SEC=604800

# Competition leaderboard cache (seconds)
# LEADERBOARD_CACHE_TTL_SEC=30

# Reminder cron batch size when cursor-scanning enabled reminders
# REMINDER_CRON_BATCH=1000
